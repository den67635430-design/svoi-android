<?xml version="1.0" encoding="utf-8"?>
<!-- СВОи Мессенджер — Tutorial overlay layout -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tutorialOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000">

    <!-- Стрелка на целевой элемент -->
    <ImageView
        android:id="@+id/tutorialArrow"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_tutorial_arrow"
        android:tint="@color/white"
        android:contentDescription="@string/tutorial_arrow_desc"
        android:visibility="gone"
        tools:visibility="visible"
        tools:layout_marginTop="200dp"
        tools:layout_marginStart="100dp"/>

    <!-- Карточка с описанием внизу экрана -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_tutorial_card"
        android:padding="24dp"
        android:layout_margin="16dp">

        <!-- Прогресс (1/8, 2/8, ...) -->
        <TextView
            android:id="@+id/tutorialProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            tools:text="1/8"/>

        <TextView
            android:id="@+id/tutorialTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Поиск контактов"/>

        <TextView
            android:id="@+id/tutorialDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            tools:text="Нажмите сюда, чтобы найти своих друзей"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/tutorialSkipButton"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tutorial_skip"
                android:textColor="#80FFFFFF"/>

            <Button
                android:id="@+id/tutorialNextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/tutorial_next"
                android:backgroundTint="@color/element_primary_color"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
