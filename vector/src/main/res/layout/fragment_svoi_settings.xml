<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Настройки СВОи"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/adminBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Mode"
            android:background="#FFD700"
            android:textColor="#000000"
            android:padding="8dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            tools:visibility="visible"/>

        <TextView
            android:id="@+id/demoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Demo режим"
            android:background="#4CAF50"
            android:textColor="#FFFFFF"
            android:padding="8dp"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/currentTierLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            tools:text="Текущая подписка: Free"/>

        <LinearLayout
            android:id="@+id/buttonSubscriptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="20dp"
            android:layout_marginTop="24dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Подписки"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Free / Premium (449 руб) / Business (749 руб)"
                android:textColor="#CCCCCC"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttonDonate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="20dp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Помочь разработчику"
                android:textColor="#4CAF50"
                android:textSize="20sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Поддержите развитие СВОи любой суммой (10-10000 руб)"
                android:textColor="#CCCCCC"
                android:layout_marginTop="6dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
